<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar" aria-label="Main navigation">
        <a class="logo" href="@Url.Action("Index", "Home")"><span>Gift</span> of the Givers</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">
            <span class="sr-only">Toggle navigation</span>
            <span aria-hidden="true">&#9776;</span>
        </button>
        <div class="nav-links" id="main-navigation">
            <a href="@Url.Action("Index", "Home")">Home</a>
            <a href="@Url.Action("Donate", "Donor")">Donate</a>
            <a href="@Url.Action("Volunteer", "Volunteer")">Volunteer</a>
            <a href="@Url.Action("Login", "Register")">Login</a>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        &copy; @DateTime.Now.Year Gift of the Givers. All rights reserved.
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>