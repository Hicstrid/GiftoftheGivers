@model List<Part1.Models.Volunteer>
@{
    ViewData["Title"] = "Volunteers";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Volunteers - Gift of the Givers</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
        }

        .container {
            max-width: 1000px;
            margin: 40px auto;
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        .header-text {
            text-align: center;
            margin-bottom: 30px;
        }

            .header-text h1 {
                color: #8B0000;
                font-size: 32px;
            }

            .header-text p {
                color: #666;
                font-size: 16px;
            }

        .search-box {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background: #f8f9fa;
        }

        .status {
            color: #28a745;
            font-weight: bold;
        }

        .btn {
            display: inline-block;
            padding: 10px 20px;
            background: #8B0000;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }

            .btn:hover {
                background: #6B0000;
            }

        .btn-secondary {
            background: #6c757d;
        }

            .btn-secondary:hover {
                background: #5a6268;
            }

        .text-center {
            text-align: center;
        }

        .mt-20 {
            margin-top: 20px;
        }

        .btn-group {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-text">
            <h1> Gift of the Givers</h1>
            <p>where your help is always appreciated</p>
        </div>

        <h2>List of all registered volunteers.</h2>

        <input type="text" class="search-box" placeholder="Search volunteers..." />

        @if (Model != null && Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Date Joined</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.OrderByDescending(v => v.ApplicationDate))
                    {
                        <tr>
                            <td>@v.Fullname</td>
                            <td>@v.Email</td>
                            <td>@v.Phone</td>
                            <td>@v.ApplicationDate.ToString("dd MMM yyyy")</td>
                            <td class="status">Active</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="background:#fff3cd; padding:20px; border-radius:5px; text-align:center;">
                <p>No volunteers registered yet.</p>
            </div>
        }

        <div class="btn-group mt-20">
            <a href="@Url.Action("Dashboard", "Employee")" class="btn btn-secondary">Back to Dashboard</a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Back to Home</a>
        </div>
    </div>
</body>
</html>