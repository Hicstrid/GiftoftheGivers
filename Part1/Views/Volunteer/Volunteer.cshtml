@model Part1.Models.Volunteer
@{
    ViewData["Title"] = "Volunteer Registration";
    ViewData["ContainerClass"] = "container-auth";
}

<section class="volunteer-apply" aria-labelledby="volunteer-title">
    <div class="volunteer-apply-intro">
        <p class="eyebrow">People in action</p>
        <h1 id="volunteer-title">Bring your skills to the response.</h1>
        <p>Tell us a little about yourself and we will connect your time and experience with the work that needs it most.</p>
        <div class="volunteer-points">
            <span>Food and clothing distribution</span>
            <span>Logistics and first aid</span>
            <span>Administration and events</span>
        </div>
    </div>
    <div class="volunteer-form-wrap">
        <p class="auth-kicker">Volunteer application</p>
        <form asp-action="Volunteer" method="post" class="auth-form volunteer-form">
            <div class="form-group">
                <label asp-for="Fullname">Full name</label>
                <input asp-for="Fullname" autocomplete="name" placeholder="Enter your full name" required />
            </div>
            <div class="volunteer-form-row">
                <div class="form-group">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" required />
                </div>
                <div class="form-group">
                    <label asp-for="Phone">Phone number</label>
                    <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="082 000 0000" required />
                </div>
            </div>
            <div class="volunteer-form-row">
                <div class="form-group">
                    <label asp-for="Skills">Skills or interests</label>
                    <select asp-for="Skills" required>
                        <option value="">Select an area</option>
                        <option value="Food Distribution">Food distribution</option>
                        <option value="Clothes Sorting">Clothes sorting</option>
                        <option value="Administration">Administration</option>
                        <option value="Events">Events</option>
                        <option value="First Aid">First aid</option>
                        <option value="Logistics">Logistics</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Availability">Availability</label>
                    <select asp-for="Availability" required>
                        <option value="">Select availability</option>
                        <option value="Weekdays">Weekdays</option>
                        <option value="Weekends">Weekends</option>
                        <option value="Evenings">Evenings</option>
                        <option value="Flexible">Flexible</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-auth">Submit application</button>
        </form>
        <p class="auth-back"><a href="@Url.Action("Index", "Home")">&larr; Back to home</a></p>
    </div>
</section>
