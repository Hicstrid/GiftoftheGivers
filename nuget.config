<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="GiftOfTheGiversHelpers" value="https://pkgs.dev.azure.com/GiftOfTheGiversTeam/Gift%20of%20the%20Givers%20Relief%20Management%20System/_packaging/GiftOfTheGiversHelpers/nuget/v3/index.json" />
  </packageSources>

  <!-- Our own packages only come from the Azure Artifacts feed, everything else from nuget.org -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GiftOfTheGiversHelpers">
      <package pattern="GiftOfTheGivers.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
